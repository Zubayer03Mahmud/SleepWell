rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated and matches the userId
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Sleep Sessions Subcollection Rules
      match /sleepSessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
